                    },
                    {
                        "type": "string",
                        "description": "开始日期,格式 YYYY-MM-DD",
                        "name": "start",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "结束日期,格式 YYYY-MM-DD,不早于 start,跨度不超过 31 天",
                        "name": "end",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "业务错误时 success=false,message 说明原因",
                        "schema": {
                            "$ref": "#/definitions/dto.BillingReportAPIResponse"
                        }
                    }
                }
            }
        },
