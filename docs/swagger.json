{
    "swagger": "2.0",
    "info": {
        "description": "cuberouter API 网关 —— 用户与账号相关接口(对外第三方)",
        "title": "cuberouter 用户 API",
        "contact": {},
        "version": "2.0"
    },
    "basePath": "/api/v2",
    "paths": {
        "/channel/{id}/import_models_csv": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "渠道-模型导入"
                ],
                "summary": "CSV 批量导入渠道模型/价格/介绍",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "渠道 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "UCloud CSV 文件(UTF-8)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data 为 dto.ImportCsvResult 结构化结果",
                        "schema": {
                            "$ref": "#/definitions/dto.ImportCsvAPIResponse"
                        }
                    },
                    "400": {
                        "description": "invalid channel id / no_file / bad_header / invalid_csv_row / too_many_rows / bad_encoding / channel_not_found",
                        "schema": {
                            "$ref": "#/definitions/dto.APIResponse"
                        }
                    },
                    "413": {
                        "description": "file_too_large",
                        "schema": {
                            "$ref": "#/definitions/dto.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.APIResponse"
                        }
                    }
                }
            }
        },
        "/data/billing": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "按用户与日期范围汇总 token 用量与费用,含按模型汇总与按日明细。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "计费报表"
                ],
                "summary": "查询用户计费账单报表(管理员)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "用户 ID",
                        "name": "user_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "开始日期,格式 YYYY-MM-DD",
                        "name": "start",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "结束日期,格式 YYYY-MM-DD,不早于 start,跨度不超过 31 天",
                        "name": "end",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "业务错误时 success=false,message 说明原因",
                        "schema": {
                            "$ref": "#/definitions/dto.BillingReportAPIResponse"
                        }
                    }
                }
            }
        },
        "/data/reconciliation": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "按日期范围汇总所有用户的计费总金额(无交易明细),按金额降序,含全平台合计。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "计费报表"
                ],
                "summary": "查询计费对账报表(管理员)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "开始日期,格式 YYYY-MM-DD",
                        "name": "start",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "结束日期,格式 YYYY-MM-DD,不早于 start,跨度不超过 31 天",
                        "name": "end",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "业务错误时 success=false,message 说明原因",
                        "schema": {
                            "$ref": "#/definitions/dto.ReconciliationReportAPIResponse"
                        }
                    }
                }
            }
        },
        "/ops/data/billing": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "运营人员仅可查询自己邀请的用户,管理员可查询任意用户。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "计费报表"
                ],
                "summary": "查询用户计费账单报表(运营/管理员)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "用户 ID",
