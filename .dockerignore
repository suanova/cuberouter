.github
.git
*.md
.vscode
.gitignore
Makefile
# Exclude docs content, but not docs/docs.go: router/main.go imports the
# generated swagger docs package, so excluding the whole directory breaks
# go build inside the image. List the excluded subpaths explicitly instead
# of 'docs' + negation, which is unreliable across builders.
docs/*.md
docs/channel
docs/images
docs/installation
docs/openapi
docs/superpowers
.eslintcache
.gocache
/web/node_modules
/web/dist
!THIRD-PARTY-LICENSES.md
# Docs sites (docs-site/{user,admin}) are built inside the image (see
# Dockerfile). The blanket *.md rule above must not strip their markdown
# sources, and local install/build artifacts never belong in the context.
!docs-site/**/*.md
node_modules
docs-site/**/.vitepress/dist
docs-site/**/.vitepress/cache
